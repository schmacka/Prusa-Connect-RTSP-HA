# Python
__pycache__/
*.py[cod]
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local, per-machine agent context and scratch state. Never checked in —
# listed here so an automated checkpoint commit cannot pick them up.
# (.beads/ is deliberately NOT here: the repo tracks it, and beads ships its
# own .beads/.gitignore for the parts that are runtime state.)
CLAUDE.local.md
.runtime/
